<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear/><add value="default.asp"/></files></defaultDocument>
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />
    <security><requestFiltering>
      <requestLimits maxAllowedContentLength="1048576" />
      <hiddenSegments>
        <add segment="includes"/><remove segment="App_Data"/><add segment="App_Data"/><add segment="database"/>
        <add segment="scripts"/><add segment="tests"/><add segment=".git"/>
        <add segment=".local"/><add segment="SongFiles"/>
      </hiddenSegments>
      <fileExtensions><add fileExtension=".sql" allowed="false"/><add fileExtension=".zip" allowed="false"/><add fileExtension=".ps1" allowed="false"/><add fileExtension=".md" allowed="false"/></fileExtensions>
    </requestFiltering></security>
    <staticContent><remove fileExtension=".svg"/><mimeMap fileExtension=".svg" mimeType="image/svg+xml"/></staticContent>
  </system.webServer>
</configuration>
